{
  "expo": {
    "name": "سائق ميدي فاست",
    "slug": "medifast-driver",
    "scheme": "medifast-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "السماح للتطبيق بالوصول إلى موقعك لتتبع التوصيل وعرض الطلبات القريبة."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medifast.driver"
    },
    "android": {
      "package": "com.medifast.driver"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}