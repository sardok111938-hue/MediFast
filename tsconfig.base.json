{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "allowJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@medifast/types": [
        "packages/types/src"
      ],
      "@medifast/supabase": [
        "packages/supabase/src"
      ],
      "@medifast/i18n": [
        "packages/i18n/src"
      ],
      "@medifast/ui": [
        "packages/ui/src"
      ]
    },
    "noEmit": true
  }
}
